# Instagram Graph API 인증 정보
# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요:
#   cp .env.example .env
#
# ⚠️ .env 는 절대 커밋/공유하지 마세요 (access_token 은 비밀키입니다)

# 내 인스타그램 비즈니스 계정의 IG User ID (숫자)
ig_user_id=17841400000000000

# Instagram Graph API 액세스 토큰 (EAAG... 로 시작, 60일마다 갱신)
# 필요 권한: instagram_basic, instagram_manage_insights,
#            pages_read_engagement, pages_show_list
#
# 두 값을 받는 방법은 meta_api_setup.txt 에 단계별로 정리되어 있습니다.
access_token=EAAG...
